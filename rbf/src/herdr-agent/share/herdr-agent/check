  $herdr session delete $s18_name >/dev/null 2>&1
  rm -rf -- $herdr_config/sessions/$s18_name

  s18_still_listed=$($herdr session list --json 2>/dev/null | jq -r --arg s "$s18_name" '.sessions[]? | select(.name == $s) | .name')
  if [[ -z $s18_still_listed && ! -d $herdr_config/sessions/$s18_name ]]; then
