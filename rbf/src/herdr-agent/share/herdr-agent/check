stub_herdr emptytabs 'tab list' 'exit 0'
rm -f -- $work/attach.*(N) $work/fail-emptytabs.out $work/noargs.calls
s15_counts=$(open_counts)
( cd $work/proj && PATH=$work/stub-emptytabs:$PATH /usr/bin/script -q $work/fail-emptytabs.out $launcher open >/dev/null )
if stopped_with $work/fail-emptytabs.out $? "herdr-agent: herdr couldn't open a shell tab in $session" &&
   [[ $(open_counts) == "$s15_counts" ]]; then
  pass "an empty tab list stops open, and it makes no workspace and no tab"
