fi

h tab focus $tab_claude_other >/dev/null 2>&1
rm -f -- $work/attach.*(N)
( cd $work/other && /usr/bin/script -q /dev/null $launcher open >/dev/null )
wait_for 5 attaches 1

s4_labels_2=$(h tab list --workspace $ws_other 2>/dev/null | jq -r '[.result.tabs[].label] | join(",")')
if [[ $s4_labels_2 == "claude,shell" ]] && chose_tab $ws_other $tab_shell_other $pane_shell_other; then
  pass "with an agent-labelled tab ahead of it at the same folder, a second open chose the shell tab"
else
  fail "second open with agent tab ahead failed: labels=$s4_labels_2"
fi

# Scenario 5: he can type in that shell, from wherever the focus was
# The guard stands in for herdr on this run's PATH and refuses a call that isn't aimed at the
# throwaway session: the launcher's calls, and its final `session attach`
mkdir -p -- $work/stub-guard
cat >$work/stub-guard/herdr <<EOF
#!/bin/zsh -f
zmodload zsh/datetime
[[ "\$*" == "session attach $session" ]] && print -r -- \$EPOCHREALTIME >${(q)work}/attach-at
[[ "\$*" == *"--session $session "* || "\$*" == "session attach $session" ]] ||
  { print -r -- "\$*" >>${(q)work}/guard.refused; exit 1 }
exec ${(q)herdr} "\$@"
EOF
chmod +x $work/stub-guard/herdr
h workspace focus $ws_other >/dev/null 2>&1
h tab focus $tab_claude_other >/dev/null 2>&1
rm -f -- $work/landed $work/tty-open.log $work/guard.refused $work/attach-at $work/key-sent
# The keys come from a coprocess that stays open until we stop the client, so no end-of-file
# reaches the shell in the pane; backgrounded on its own, `script` is $!
coproc { sleep 3; print -r -- $EPOCHREALTIME >| ${(q)work}/key-sent; print -r -- "pwd >| ${(q)work}/landed"; exec sleep 30 }
s5_keys=$!
PATH=$work/stub-guard:$PATH HERDR_AGENT_ATTACH= /usr/bin/script -q $work/tty-open.log /bin/zsh -fc 'cd "$1"; stty rows 40 cols 120; shift; exec "$@"' sized $work/proj $launcher open <&p >/dev/null &
s5_pid=$!
wait_for 10 test -f $work/key-sent
wait_for 10 test -f $work/landed
s5_seen=$EPOCHREALTIME
# stop the client (and `script`) before the keys end, then the keys
# by parent, not by pattern: the client is `script`'s own child (open and the launcher exec into it),
# and a pattern on the session name would also hit another check's client
s5_clients=($(/usr/bin/pgrep -P $s5_pid))
s5_cmd=$(/bin/ps -o command= -p ${s5_clients[1]:-0} 2>/dev/null)
kill $s5_clients $s5_pid >/dev/null 2>&1
wait_for 5 gone $s5_pid
s5_left=0
for s5_client in $s5_clients; do wait_for 5 gone $s5_client || s5_left=1; done
kill $s5_keys >/dev/null 2>&1
wait $s5_pid $s5_keys 2>/dev/null

landed_content=
[[ -f $work/landed ]] && landed_content=$(<$work/landed)
# The viewer must be attached before the key is sent (so the key isn't queued in the terminal and
# handed over late), and the key must land within a second of being sent
s5_sent=999 s5_attached=999
[[ -f $work/key-sent ]] && s5_sent=$(<$work/key-sent)
[[ -f $work/attach-at ]] && s5_attached=$(<$work/attach-at)
s5_lag=$(( s5_seen - s5_sent ))
if [[ -n $landed_content && ${landed_content:A} == "${${:-$work/proj}:A}" ]] &&
   [[ ! -e $work/guard.refused ]] && (( $#s5_clients == 1 && s5_left == 0 )) && [[ $s5_cmd == *" session attach $session" ]] &&
   (( s5_attached < s5_sent && s5_lag >= 0 && s5_lag < 1 )) &&
   /usr/bin/perl -0777 -ne 'exit(/\A\e\[/ ? 0 : 1)' $work/tty-open.log; then
  pass "with the focus on another workspace's agent tab, a key sent 3 s after bare herdr, with the viewer already attached, went to the shell at the folder within 1 s"
else
