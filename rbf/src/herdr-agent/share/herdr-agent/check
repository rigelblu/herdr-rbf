# Scenario 21: it writes nothing but locks (checked last, so every open of section 6 counts)
# Every open of section 6 ran against this section's own state folder, workspace and tab creates,
# the server starts, the subfolder, outside-a-checkout and root runs included. Agent launches write
# their notes elsewhere. Only the folders and empty lock files, however many, may be in it
s21_state=$HERDR_AGENT_STATE_DIR
s21_extra=()
for s21_file in ${(f)"$(find $s21_state 2>/dev/null)"}; do
  [[ $s21_file == $s21_state || $s21_file == $s21_state/locks ||
    ( $s21_file == $s21_state/locks/*.lock && -f $s21_file && ! -s $s21_file ) ]] || s21_extra+=($s21_file)
done
